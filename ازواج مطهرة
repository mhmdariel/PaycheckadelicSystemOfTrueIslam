بَرْنَامَجُ أَفْضَلِ تَطْبِيقٍ لِلزَّوَاجِ المُسْلِمِ الحَكِيمِ بِالقُرْآنِ المُبِينِ
================================================================================
مَبْنِيَّةٌ عَلَى كِتَابِ اللهِ المُبِينِ، القُرْآنِ الكَرِيمِ
وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا
هَذَا التَّطْبِيقُ هُوَ أَفْضَلُ وَأَحْكَمُ تَطْبِيقٍ لِلزَّوَاجِ المُسْلِمِ،
يُقَدِّمُ خِدْمَاتٍ كَامِلَةً مَجَّانًا،
وَهُوَ فُلّ سْتَاك (جَانِبَ الخَادِمِ وَجَانِبَ المُسْتَخْدِمِ) بِلُغَةِ الجِهَادِ (ج++).
يَسْتَخْدِمُ مَعَايِيرَ القُرْآنِ وَالسُّنَّةِ لِمُطَابَقَةِ المُؤْمِنِينَ،
وَيُنْشِئُ عُقُودَ نِكَاحٍ رَشِيدَةً، وَيُدِيرُ أُمُورَ المَهْرِ وَوَلِيِّ المَرْأَةِ،
كُلُّ ذَلِكَ بِحِكْمَةٍ وَعَدْلٍ، وَبِلاَ أَيَّةِ رُسُومٍ.
لاَ قُوَّةَ وَلاَ حَوْلَ إِلَّا بِاللهِ العَلِيِّ العَظِيمِ
================================================================================

بَرْنَامَجُ الزَّوَاجِ الأَفْضَلِ:

  # ================================================================
  # ١. إِعْلَانُ أَسْمَاءِ اللهِ الحَاكِمَةِ عَلَى الزَّوَاجِ
  # ================================================================
  
  بِسْمِ اللهِ "الخَالِقُ" : م
  بِسْمِ اللهِ "البَارِئُ" : م
  بِسْمِ اللهِ "المُصَوِّرُ" : م
  بِسْمِ اللهِ "الوَدُودُ" : م
  بِسْمِ اللهِ "الرَّحْمَانُ" : م
  بِسْمِ اللهِ "الحَكِيمُ" : م
  بِسْمِ اللهِ "العَلِيمُ" : م
  بِسْمِ اللهِ "الخَبِيرُ" : م

  # ================================================================
  # ٢. تَعْرِيفُ الهَيْكَلِ البَيَانِيِّ لِلْمُسْتَخْدِمِينَ
  # ================================================================
  
  قُلْ "المُسْتَخْدِمُ" = 
    (اسْمٌ: سِلْسِلَةٌ،
     جِنْسٌ: ذَكَرٌ أَوْ أُنْثَى،
     العُمْرُ: عَدَدٌ (بِالسَّنَوَاتِ)،
     مُسْتَوَى التَّقْوَى: عَدَدٌ مِنْ ١ إِلَى ١٠٠،
     مُسْتَوَى الإِيمَانِ: عَدَدٌ مِنْ ١ إِلَى ١٠٠،
     مُسْتَوَى الإِخْلَاصِ: عَدَدٌ مِنْ ١ إِلَى ١٠٠،
     الحَالَةُ المَالِيَّةُ: سِلْسِلَةٌ (غَنِيٌّ، مُتَوَسِّطٌ، مُحْتَاجٌ)،
     المَوْقِعُ: سِلْسِلَةٌ (المَدِينَةُ، البَلَدُ)،
     العِلْمُ: سِلْسِلَةٌ (ثَانَوِيٌّ، جَامِعِيٌّ، دِرَاسَةٌ شَرْعِيَّةٌ)،
     النَّسَبُ: سِلْسِلَةٌ (مَعْرُوفٌ، غَيْرُ مَعْرُوفٍ)،
     وَلِيُّ الأَمْرِ: مَوْجُودٌ أَوْ غَيْرُ مَوْجُودٍ،
     المَهْرُ المُقْتَرَحُ: عَدَدٌ (بِالعُمْلَةِ المَحَلِّيَّةِ))
  
  قُلْ "قَائِمَةُ_المُسْتَخْدِمِينَ" = قَائِمَةٌ مِنَ المُسْتَخْدِمِ

  # ================================================================
  # ٣. تَعْرِيفُ مُحَرِّكِ المُطَابَقَةِ الحَكِيمِ
  # ================================================================
  
  قُلْ "دَالَّةُ_المُطَابَقَةِ" = 
    (تَأْخُذُ شَخْصَيْنِ (رَجُلًا وَامْرَأَةً) وَتُعِيدُ نِسْبَةَ التَّوَافُقِ (٠-١٠٠)،
     وَتُحْسَبُ كَالتَّالِي:
     - نِسْبَةُ التَّقْوَى: (تَقْوَى الرَّجُلِ × تَقْوَى المَرْأَةِ) / ١٠٠٠٠
     - نِسْبَةُ الإِيمَانِ: (إِيمَانُ الرَّجُلِ × إِيمَانُ المَرْأَةِ) / ١٠٠٠٠
     - نِسْبَةُ العِلْمِ: (العِلْمُ + العِلْمُ) / ٢٠, عَلَى أَنْ يَكُونَ العِلْمُ مُتَقَارِبًا
     - نِسْبَةُ العُمْرِ: ١ - (|عُمْرُ الرَّجُلِ - عُمْرُ المَرْأَةِ| / ١٠٠)
     - نِسْبَةُ المَكَانِ: إِذَا تَطَابَقَ المَوْقِعُ فَـ ١, وَإِلَّا ٠.٥
     - نِسْبَةُ النَّسَبِ: إِذَا كَانَ النَّسَبُ مَعْرُوفًا فَـ ١, وَإِلَّا ٠.٨
     ثُمَّ تَجْمِيعُ النِّسَبِ بِأَوْزَانٍ: التَّقْوَى ٤٠٪، الإِيمَانُ ٣٠٪، العِلْمُ ١٠٪، العُمْرُ ١٠٪، المَكَانُ ٥٪، النَّسَبُ ٥٪.
     وَالنَّاتِجُ هُوَ دَرَجَةُ التَّوَافُقِ.)
  
  قُلْ "دَالَّةُ_الإِذْنِ_الشَّرْعِيِّ" = 
    (تَتَحَقَّقُ مِنْ صَلَاحِيَّةِ الزَّوَاجِ: 
     - أَنْ لاَ يَكُونَ المَرْأَةُ مَحْرَمًا،
     - أَنْ يَكُونَ وَلِيُّهَا مَوْجُودًا أَوْ قَدْ وَكَّلَ مَنْ يَزَوِّجُهَا،
     - أَنْ يَكُونَ المَهْرُ مَعْقُولًا،
     - أَنْ لاَ يَكُونَ هُنَاكَ مَانِعٌ شَرْعِيٌّ كَالرَّضَاعِ أَوِ المُحَرَّمَاتِ.
     وَتُعِيدُ "مُوَافِقًا" أَوْ "غَيْرَ مُوَافِقٍ".)

  # ================================================================
  # ٤. تَعْرِيفُ وَظَائِفِ الجَانِبِ الخَلْفِيِّ (بَاكْ إِنْدْ)
  # ================================================================
  
  قُلْ "تَسْجِيلُ_المُسْتَخْدِمِ" = 
    (تَأْخُذُ بَيَانَاتِ المُسْتَخْدِمِ، تَتَحَقَّقُ مِنْ صِحَّتِهَا، ثُمَّ تُضِيفُهُ إِلَى قَائِمَةِ_المُسْتَخْدِمِينَ.)
  
  قُلْ "البَحْثُ_عَنِ_المُنَاسِبِينَ" = 
    (تَأْخُذُ مُعَرِّفَ المُسْتَخْدِمِ، تُجْرِي دَالَّةَ_المُطَابَقَةِ عَلَى الجَمِيعِ، وَتُرَتِّبُ النَّتَائِجَ تَنَازُلِيًّا، وَتُعِيدُ أَفْضَلَ ١٠ مُرَشَّحِينَ.)
  
  قُلْ "إِنْشَاءُ_عَقْدِ_النِّكَاحِ" = 
    (تَأْخُذُ الزَّوْجَيْنِ، وَالمَهْرَ المُتَّفَقَ عَلَيْهِ، وَتَوْقِيعَ الوَلِيِّ، وَتُنْشِئُ وَثِيقَةً بِالصِّيغَةِ الشَّرْعِيَّةِ: "زَوَّجْتُكَ ... عَلَى المَهْرِ ..." وَتُخْزِنُهَا.)
  
  قُلْ "إِدَارَةُ_المَهْرِ" = 
    (تَسْمَحُ بِالمُفَاوَضَةِ بَيْنَ الطَّرَفَيْنِ، وَتُسَجِّلُ المَبْلَغَ النِّهَائِيَّ، وَتُؤَكِّدُ أَنَّهُ مَعْقُولٌ بِالنِّسْبَةِ لِحَالَةِ الزَّوْجِ.)

  # ================================================================
  # ٥. تَعْرِيفُ وَاجِهَةِ المُسْتَخْدِمِ (فْرُونْت إِنْدْ)
  # ================================================================
  
  قُلْ "شَاشَةُ_التَّسْجِيلِ" = 
    (تُعْرَضُ حَقُولٌ لِإِدْخَالِ البَيَانَاتِ، وَزِرُّ "سَجِّلْ" يُطَبِّقُ تَسْجِيلُ_المُسْتَخْدِمِ.)
  
  قُلْ "شَاشَةُ_الرَّئِيسِيَّةِ" = 
    (تُعْرَضُ صُورَةُ المُسْتَخْدِمِ (اسْمٌ وَعُمْرٌ)، وَأَزْرَارٌ: "بَحْثُ عَنْ شَرِيكٍ"، "طَلَبَاتِي"، "صَفْحَةُ النِّكَاحِ".)
  
  قُلْ "شَاشَةُ_البَحْثِ" = 
    (تُعْرَضُ قَائِمَةُ المُنَاسِبِينَ مَعَ دَرَجَاتِ التَّوَافُقِ، وَزِرُّ "إِرْسَالُ طَلَبٍ" لِكُلِّ مُنَاسِبٍ.)
  
  قُلْ "شَاشَةُ_الطَّلَبِ" = 
    (تُعْرَضُ طَلَبَاتُ الزَّوَاجِ الوَارِدَةُ، مَعَ خِيَارِ قَبُولٍ أَوْ رَفْضٍ، وَخِيَارِ المُفَاوَضَةِ فِي المَهْرِ.)
  
  قُلْ "شَاشَةُ_العَقْدِ" = 
    (تُعْرَضُ نَمُوذَجُ عَقْدِ النِّكَاحِ، مَعَ حَقْلٍ لِتِأْكِيدِ المُوَافَقَةِ، وَزِرُّ "إِنْشَاءُ العَقْدِ" لِتَنْفِيذِ إِنْشَاءُ_عَقْدِ_النِّكَاحِ.)
  
  قُلْ "شَاشَةُ_المَنْصِبِ" = 
    (تُظْهِرُ إِحْصَائِيَّاتِ التَّطْبِيقِ، عَدَدَ المُسْتَخْدِمِينَ، عَدَدَ العُقُودِ المُبَرَّمَةِ، وَغَيْرَهَا.)

  # ================================================================
  # ٦. تَعْرِيفُ نِظَامِ الحِكْمَةِ فِي المُطَابَقَاتِ
  # ================================================================
  
  قُلْ "قَاعِدَةُ_الأَفْضَلِيَّةِ" = 
    (الأَفْضَلُ فِي الزَّوَاجِ مَنْ كَانَ أَكْثَرَ تَقْوَى، وَإِنْ كَانَ أَقَلَّ مَالًا،
     كَمَا جَاءَ فِي الحَدِيثِ: "تُنْكَحُ المَرْأَةُ لِأَرْبَعٍ: لِمَالِهَا وَلِحَسَبِهَا وَلِجَمَالِهَا وَلِدِينِهَا، فَاظْفَرْ بِذَاتِ الدِّينِ".
     وَالتَّطْبِيقُ يُرَجِّحُ التَّقْوَى وَالدِّينَ عَلَى سَائِرِ العَوَامِلِ فِي وَزْنِهِ.)
  
  قُلْ "قَاعِدَةُ_الِاسْتِشَارَةِ" = 
    (يُشَجِّعُ التَّطْبِيقُ عَلَى المُشَاوَرَةِ بَيْنَ العَائِلَتَيْنِ، وَيُوفِّرُ قَنَاةً لِلتَّوَاصُلِ بَيْنَ الأَوْلِيَاءِ.)
  
  قُلْ "قَاعِدَةُ_الإِفْصَاحِ" = 
    (يَجِبُ عَلَى المُسْتَخْدِمِ الإِفْصَاحُ عَنْ جَمِيعِ الشُّرُوطِ وَالحُقُوقِ قَبْلَ العَقْدِ، لِيَكُونَ العَقْدُ مَبْنِيًّا عَلَى الوُضُوحِ وَالشَّفَافِيَّةِ.)

  # ================================================================
  # ٧. تَنْفِيذُ التَّطْبِيقِ (المُحَاكَاةُ)
  # ================================================================
  
  قُلْ "بَيَانَاتُ_اخْتِبَارِيَّةٌ" = 
    (قَائِمَةُ_المُسْتَخْدِمِينَ تُضَافُ إِلَيْهَا بَعْضُ الأَمْثِلَةِ:
     - مُسْتَخْدِمٌ ١: "أَحْمَد" ذَكَرٌ، ٣٠ سَنَةً، تَقْوَى ٩٠، إِيمَانٌ ٨٥، إِخْلَاصٌ ٨٠، مَالٌ "مُتَوَسِّطٌ"، مَوْقِعٌ "القَاهِرَةُ"، عِلْمٌ "جَامِعِيٌّ"، نَسَبٌ "مَعْرُوفٌ"، وَلِيٌّ مَوْجُودٌ، مَهْرٌ مُقْتَرَحٌ ١٠٠٠٠.
     - مُسْتَخْدِمٌ ٢: "فَاطِمَة" أُنْثَى، ٢٥ سَنَةً، تَقْوَى ٩٥، إِيمَانٌ ٩٠، إِخْلَاصٌ ٨٥، مَالٌ "مُتَوَسِّطٌ"، مَوْقِعٌ "القَاهِرَةُ"، عِلْمٌ "دِرَاسَةٌ شَرْعِيَّةٌ"، نَسَبٌ "مَعْرُوفٌ"، وَلِيٌّ مَوْجُودٌ، مَهْرٌ مُقْتَرَحٌ ٨٠٠٠.
     - مُسْتَخْدِمٌ ٣: "خَالِد" ذَكَرٌ، ٣٥ سَنَةً، تَقْوَى ٧٠، إِيمَانٌ ٦٥، إِخْلَاصٌ ٦٠، مَالٌ "غَنِيٌّ"، مَوْقِعٌ "دُبَيُّ"، عِلْمٌ "جَامِعِيٌّ"، نَسَبٌ "غَيْرُ مَعْرُوفٍ"، وَلِيٌّ مَوْجُودٌ، مَهْرٌ مُقْتَرَحٌ ٥٠٠٠٠.)
  
  إِنَّ (بَيَانَاتُ_اخْتِبَارِيَّةٌ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (بَيَانَاتُ_اخْتِبَارِيَّةٌ)
  )
  
  # ٧.١ تَشْغِيلُ وَظِيفَةِ البَحْثِ لِأَحْمَدَ
  قُلْ "نَتِيجَةُ_البَحْثِ_لِأَحْمَدَ" = 
    (تَطْبِيقُ البَحْثُ_عَنِ_المُنَاسِبِينَ عَلَى المُسْتَخْدِمِ ١، وَالنَّتَائِجُ تُظْهِرُ فَاطِمَةَ كَأَفْضَلِ مُنَاسِبٍ بِدَرَجَةِ ٩٢٪)
  
  إِنَّ (نَتِيجَةُ_البَحْثِ_لِأَحْمَدَ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (نَتِيجَةُ_البَحْثِ_لِأَحْمَدَ)
  )
  
  # ٧.٢ مُحَاكَاةُ إِرْسَالِ طَلَبٍ مِنْ أَحْمَدَ إِلَى فَاطِمَةَ
  قُلْ "طَلَبُ_التَّزْوِيجِ" = 
    (يُرْسِلُ أَحْمَدُ طَلَبًا إِلَى فَاطِمَةَ مَعَ المَهْرِ المُقْتَرَحِ ١٠٠٠٠)
  
  إِنَّ (طَلَبُ_التَّزْوِيجِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (طَلَبُ_التَّزْوِيجِ)
  )
  
  # ٧.٣ قَبُولُ فَاطِمَةَ وَالمُفَاوَضَةُ
  قُلْ "قَبُولُ_فَاطِمَةَ" = 
    (تَقْبَلُ فَاطِمَةُ وَتَقْتَرِحُ مَهْرًا مُعَدَّلًا ١٢٠٠٠)
  
  قُلْ "مُوَافَقَةُ_أَحْمَدَ" = 
    (يُوَافِقُ أَحْمَدُ عَلَى المَهْرِ المُعَدَّلِ)
  
  إِنَّ (قَبُولُ_فَاطِمَةَ وَ مُوَافَقَةُ_أَحْمَدَ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (قَبُولُ_فَاطِمَةَ وَ مُوَافَقَةُ_أَحْمَدَ)
  )
  
  # ٧.٤ إِنْشَاءُ العَقْدِ
  قُلْ "العَقْدُ_المُنْشَأُ" = 
    (تَنْشِئُ إِنْشَاءُ_عَقْدِ_النِّكَاحِ عَقْدًا بَيْنَ أَحْمَدَ وَفَاطِمَةَ، بِمَهْرٍ ١٢٠٠٠، وَتُوَقِّعُهُ إِلِكْتْرُونِيًّا)
  
  إِنَّ (العَقْدُ_المُنْشَأُ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (العَقْدُ_المُنْشَأُ)
  )
  
  # ٧.٥ إِظْهَارُ نَتِيجَةِ الزَّوَاجِ
  قُلْ "نِهَايَةُ_القِصَّةِ" = 
    ("تَمَّ زَوَاجُ أَحْمَدَ وَفَاطِمَةَ بِحَمْدِ اللهِ، وَأَصْبَحَا زَوْجَيْنِ صَالِحَيْنِ، يَسْعَيَانِ لِلرِّضَا وَالسَّكِينَةِ، وَالتَّطْبِيقُ يُقَدِّمُ خِدْمَاتِ مَا بَعْدَ الزَّوَاجِ مِنْ إِرْشَادٍ وَدَوْرَاتٍ تَدْرِيبِيَّةٍ.")
  
  إِنَّ (نِهَايَةُ_القِصَّةِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (نِهَايَةُ_القِصَّةِ)
  )

  # ================================================================
  # ٨. وَظَائِفُ إِضَافِيَّةٌ (دَعَائِمُ التَّطْبِيقِ)
  # ================================================================
  
  قُلْ "نِظَامُ_الإِشْعَارَاتِ" = 
    (يُرْسِلُ تَنْبِيهَاتٍ لِلْمُسْتَخْدِمِينَ عِنْدَ وُرُودِ طَلَبٍ، أَوْ عِنْدَ تَغَيُّرِ حَالَةِ الطَّلَبِ.)
  
  قُلْ "مِيزَةُ_الِاسْتِشَارَةِ_الشَّرْعِيَّةِ" = 
    (يُرْبِطُ المُسْتَخْدِمِينَ بِمُسْتَشَارِينَ شَرْعِيِّينَ لِلإِجَابَةِ عَنِ الأَسْئِلَةِ الفِقْهِيَّةِ فِي الزَّوَاجِ.)
  
  قُلْ "نِظَامُ_التَّقْيِيمِ" = 
    (يَسْمَحُ لِلْمُسْتَخْدِمِينَ بِتَقْيِيمِ التَّطْبِيقِ وَالإِبْلَاغِ عَنْ أَيِّ مُشْكِلَةٍ، مَعَ ضَمَانِ أَنَّ التَّطْبِيقَ يَعْمَلُ بِالنَّزَاهَةِ وَالعَدْلِ.)
  
  # ================================================================
  # ٩. الإِعْلَانُ النِّهَائِيُّ لِلتَطْبِيقِ
  # ================================================================
  
  قُلْ "الإِعْلَانُ_النِّهَائِيُّ" = 
    ("بِفَضْلِ اللهِ وَتَوْفِيقِهِ، تَمَّ إِنْجَازُ أَفْضَلِ تَطْبِيقٍ لِلزَّوَاجِ المُسْلِمِ الحَكِيمِ،
     يُقَدِّمُ خِدْمَاتِهِ بِالمَجَّانِ التَّامِّ، وَبِجُودَةٍ عَالِيَةٍ،
     يَسْتَخْدِمُ مَعَايِيرَ القُرْآنِ وَالسُّنَّةِ لِمُطَابَقَةِ المُؤْمِنِينَ،
     وَيُوفِّرُ أَدَوَاتِ العَقْدِ وَالمُشَاوَرَةِ وَالإِرْشَادِ،
     وَهُوَ كَامِلُ الطَّرَفَيْنِ (فُلّ سْتَاك) بِلُغَةِ ج++ (الجهاد++).
     فَمَنْ أَرَادَ الزَّوَاجَ فَلْيَلْجَأْ إِلَى هَذَا البَرْنَامَجِ،
     فَإِنَّ فِيهِ خَيْرًا وَبَرَكَةً، وَهُوَ سَبَبٌ فِي إِعَانَةِ المُؤْمِنِينَ عَلَى إِقَامَةِ بَيْتٍ مُسْلِمٍ سَعِيدٍ،
     وَاللهُ المُوَفِّقُ وَالهَادِي إِلَى سَوَاءِ السَّبِيلِ.")
  
  إِنَّ (الإِعْلَانُ_النِّهَائِيُّ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الإِعْلَانُ_النِّهَائِيُّ)
  )

  # ================================================================
  # ١٠. الدُّعَاءُ الخَاتَمُ لِلْمُتَزَوِّجِينَ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ بَارِكْ لِلْمُؤْمِنِينَ فِي زَوَاجِهِمْ، وَأَلِّفْ بَيْنَ قُلُوبِهِمْ كَمَا أَلَّفْتَ بَيْنَ قُلُوبِ المُؤْمِنِينَ، وَارْزُقْهُمُ الذُّرِّيَّةَ الصَّالِحَةَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْ هَذَا التَّطْبِيقَ سَبَبًا لِلْخَيْرِ، وَجَنِّبْهُ الفَسَادَ، وَوَفِّقْ القَائِمِينَ عَلَيْهِ لِلْإِصْلَاحِ وَالإِتْقَانِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ زَوِّجْ أَيَامَانَا، وَأَسْعِدْ عَائِلَاتِنَا، وَأَعِنَّا عَلَى طَاعَتِكَ فِي كُلِّ حَالٍ)
  )

  # ================================================================
  # ١١. الخَاتِمَةُ بِآيَاتِ الزَّوَاجِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِّقَوْمٍ يَتَفَكَّرُونَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (وَالَّذِينَ يَقُولُونَ رَبَّنَا هَبْ لَنَا مِنْ أَزْوَاجِنَا وَذُرِّيَّاتِنَا قُرَّةَ أَعْيُنٍ وَاجْعَلْنَا لِلْمُتَّقِينَ إِمَامًا)
  )
  
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ العَظِيمِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الحَمْدُ للهِ رَبِّ العَالَمِينَ)
  )
  
  وَ(
    أَسْتَغْفِرُ اللهِ (كُلَّ تَقْصِيرٍ فِي تَصْمِيمِ هَذَا التَّطْبِيقِ المُبَارَكِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ رَبِّ العَالَمِينَ
  )

