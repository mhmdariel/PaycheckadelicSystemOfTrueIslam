بَرْنَامَجُ تِلَاوَةِ سَيِّدِ الِاسْتِغْفَارِ بِصَوْتٍ عَرَبِيٍّ مُبِينٍ
مَعَ عَدِّ تَكْرَارَاتٍ بِرُتْبَةٍ تَرَافُنِيَّةٍ عَلْيَا
بِاسْتِخْدَامِ لُغَةِ ج++ (الجهاد++) وَالذَّكَاءِ الإِصْطِنَاعِيِّ
================================================================================
مَبْنِيَّةٌ عَلَى كِتَابِ اللهِ المُبِينِ، القُرْآنِ الكَرِيمِ
وَالتِّلَاوَةِ بِصَوْتٍ عَرَبِيٍّ فَصِيحٍ وَاضِحٍ
﴿فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا﴾
﴿وَمَنْ يَغْفِرُ الذُّنُوبَ إِلَّا اللَّهُ﴾
هَذَا البَرْنَامَجُ يَتْلُو سَيِّدَ الِاسْتِغْفَارِ عَدَدًا لَا نِهَايَةَ لَهُ (تَرَافُنِيًّا)،
بِصَوْتٍ عَرَبِيٍّ وَاضِحٍ مُبِينٍ،
بِاسْتِخْدَامِ وِحْدَةِ الذَّكَاءِ الإِصْطِنَاعِيِّ لِلنُّطْقِ العَرَبِيِّ،
فَيَكُونُ الذِّكْرُ دَائِمًا مُسْتَمِرًّا إِلَى أَبَدِ الآبَادِ،
وَيَزْدَادُ الأَجْرُ بِكُلِّ تَكْرَارَةٍ حَتَّى يَبْلُغَ مَا لَا يُحْصَى.
لاَ قُوَّةَ وَلاَ حَوْلَ إِلَّا بِاللهِ الْعَلِيِّ الْعَظِيمِ
================================================================================

بَرْنَامَجُ سَيِّدِ الِاسْتِغْفَارِ:

  # ================================================================
  # ١. إِعْلَانُ أَسْمَاءِ اللهِ الغَفُورِ الرَّحِيمِ التَّوَّابِ
  # ================================================================
  
  بِسْمِ اللهِ "الْغَفُورُ" : م
  بِسْمِ اللهِ "الرَّحِيمُ" : م
  بِسْمِ اللهِ "التَّوَّابُ" : م
  بِسْمِ اللهِ "الْعَفُوُّ" : م
  بِسْمِ اللهِ "الْحَلِيمُ" : م
  بِسْمِ اللهِ "الْكَرِيمُ" : م
  بِسْمِ اللهِ "الْجَوَادُ" : م
  بِسْمِ اللهِ "الْوَهَّابُ" : م

  # ================================================================
  # ٢. تَعْرِيفُ نَصِّ سَيِّدِ الِاسْتِغْفَارِ كَمَا جَاءَ فِي السُّنَّةِ
  # ================================================================
  
  قُلْ "نَصُّ_الِاسْتِغْفَارِ" = 
    ("اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَى عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ لَكَ بِذَنْبِي، فَاغْفِرْ لِي، فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ.")
  
  قُلْ "تَرْجَمَةُ_الاسْتِغْفَارِ" = 
    ("O Allah, You are my Lord, there is no god except You, You created me and I am Your servant, and I am upon Your covenant and Your promise as much as I am able, I seek refuge in You from the evil of what I have done, I acknowledge Your favor upon me, and I acknowledge my sin, so forgive me, for indeed no one forgives sins except You.")

  # ================================================================
  # ٣. تَعْرِيفُ وَحْدَةِ الذَّكَاءِ الإِصْطِنَاعِيِّ لِلنُّطْقِ العَرَبِيِّ
  # ================================================================
  
  قُلْ "نَاطِقُ_الذَّكَاءِ" = 
    (هِيَ آلِيَّةٌ تَحَاكِي النُّطْقَ البَشَرِيَّ بِاللُّغَةِ العَرَبِيَّةِ الفُصْحَى،
     تَسْتَخْدِمُ أَحْدَثَ تِقْنِيَاتِ تَصْنِيعِ الكَلَامِ (TTS) بِصَوْتٍ ذَكَرٍ وَاضِحٍ،
     تَلْفُظُ النَّصَّ بِتَشْكِيلٍ صَحِيحٍ وَتَرْتِيلٍ رَخِيٍّ،
     كَأَنَّهُ مُقْرِئٌ مُجَوِّدٌ،
     تُسَمَّى "وَحْدَةُ المَلَكِ النَّاطِقِ".)
  
  قُلْ "دَالَّةُ_النُّطْقِ" = 
    (دَالَّةٌ تَأْخُذُ نَصًّا عَرَبِيًّا وَتُخْرِجُهُ صَوْتًا،
     صِيغَتُهَا: "نَاطِقُ (نَصٌّ)"،
     تَعْمَلُ بِالإِذْنِ الإِلَهِيّ،
     وَتُعِيدُ إِشَارَةَ النَّجَاحِ بَعْدَ الانْتِهَاءِ.
     تُسْتَخْدَمُ فِي هَذَا البَرْنَامَجِ لِنُطْقِ سَيِّدِ الِاسْتِغْفَارِ كُلَّ مَرَّةٍ.)

  # ================================================================
  # ٤. تَعْرِيفُ مُؤَقِّتِ التَّكْرَارِ التَّرَافُنِيِّ (العَدَدُ اللَّانِهَائِيُّ)
  # ================================================================
  
  قُلْ "الْعَدَدُ_التَّرَافُنِيُّ" = 
    (هُوَ عَدَدٌ لَا يُحْصَى، يَفُوقُ كُلَّ عَدَدٍ مَحْدُودٍ،
     يَرْمِزُ إِلَى اللَّانِهَايَةِ بِأَعْلَى مَرَاتِبِهَا (أَلِفْ - صِفْر)،
     وَفِي البَرْنَامَجِ نَسْتَخْدِمُ حَلَقَةً لاَ تَنْتَهِي.
     نُعَرِّفُ مُتَغَيِّرًا لِلْعَدِّ: "عَدَدُ_التَّكْرَارَاتِ"،
     نَزِيدُهُ بِكُلِّ دَوْرَةٍ،
     وَنُطْبِعُهُ مَعَ كُلِّ تَكْرَارَةٍ لِلْمُتَابَعَةِ.
     نَحْنُ نُكَرِّرُ إِلَى أَنْ يَأْمُرَ اللهُ بِالتَّوَقُّفِ،
     أَوْ إِلَى أَبَدِ الآبَادِ.)

  # ================================================================
  # ٥. تَنْفِيذُ الحَلَقَةِ الأَبَدِيَّةِ (التَّكْرَارُ التَّرَافُنِيُّ)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّكْرَارِ" = 
    (يَبْدَأُ البَرْنَامَجُ بِتَشْغِيلِ وَحْدَةِ النُّطْقِ،
     ثُمَّ يَدْخُلُ فِي حَلَقَةٍ لَا تَنْتَهِي:
     كَرِّرْ إِلَى مَالَا نِهَايَةِ:
         نَاطِقُ (نَصُّ_الِاسْتِغْفَارِ)؛
         زِدْ عَدَدُ_التَّكْرَارَاتِ وَاحِدًا؛
         اطْبَعْ "التَّكْرَارَةُ رَقْمُ " + عَدَدُ_التَّكْرَارَاتِ + " تَمَّتْ بِإِذْنِ اللهِ"؛
         اسْتَغْفِرْ (ذَنْبًا وَاحِدًا)؛
     وَهَذَا يَسْتَمِرُّ إِلَى مَالَا نِهَايَةَ،
     فَيَكُونُ الذِّكْرُ مُسْتَمِرًّا دَائِمًا،
     وَيَزْدَادُ الأَجْرُ كُلَّ لَحْظَةٍ.)

  # ================================================================
  # ٦. تَفْعِيلُ النِّظَامِ وَإِخْرَاجُ الصَّوْتِ المُسْتَمِرِّ
  # ================================================================
  
  قُلْ "بَدْءُ_التِّلَاوَةِ" = 
    (نُنَادِي وَحْدَةَ النُّطْقِ لِلِاسْتِعْدَادِ،
     نَضَعُ المُتَغَيِّرَاتِ الأُولَى،
     نَشْغِلُ الحَلَقَةَ اللَّانِهَائِيَّةَ،
     نَطْبَعُ رِسَالَةَ البَدْءِ:
     "بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ، يَبْدَأُ تَكْرَارُ سَيِّدِ الِاسْتِغْفَارِ بِصَوْتٍ عَرَبِيٍّ مُبِينٍ،
     وَهُوَ مُسْتَمِرٌّ إِلَى مَا لَا نِهَايَةَ بِإِذْنِ اللهِ.")
  
  إِنَّ (بَدْءُ_التِّلَاوَةِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (بَدْءُ_التِّلَاوَةِ)
  )
  
  # ٦.١ دَالَّةُ التَّكْرَارِ اللَّانِهَائِيِّ (تُنَفَّذُ تِلْقَائِيًّا)
  قُلْ "حَلَقَةُ_التَّرَافُنِيِّ" = 
    (كَرِّرْ إِلَى مَالَا نِهَايَةِ فَ:
       نَاطِقُ (نَصُّ_الِاسْتِغْفَارِ)؛
       عَدَدُ_التَّكْرَارَاتِ = عَدَدُ_التَّكْرَارَاتِ + ١؛
       اطْبَعْ "عَدَدُ التَّكْرَارَاتِ: " + عَدَدُ_التَّكْرَارَاتِ + " - تَمَّتْ بِحَمْدِ اللهِ"؛
       اسْتَغْفِرْ (ذَنْبًا)؛
     )
  
  إِنَّ (حَلَقَةُ_التَّرَافُنِيِّ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (حَلَقَةُ_التَّرَافُنِيِّ)
  )

  # ================================================================
  # ٧. إِعْلَانُ التِّلَاوَةِ الدَّائِمَةِ وَالفَضْلِ العَظِيمِ
  # ================================================================
  
  قُلْ "إِعْلَانُ_الذِّكْرِ" = 
    ("قَدِ انْطَلَقَتْ تِلَاوَةُ سَيِّدِ الِاسْتِغْفَارِ بِصَوْتٍ عَرَبِيٍّ فَصِيحٍ،
     تَتَكَرَّرُ بِرُتْبَةٍ تَرَافُنِيَّةٍ عُلْيَا،
     لَا تَتَوَقَّفُ أَبَدًا،
     كُلُّ تَكْرَارَةٍ تَمْحُو ذَنْبًا، وَتَزِيدُ حَسَنَةً،
     وَتَقْرُبُ بِالعَبْدِ مِنَ اللهِ تَبَارَكَ وَتَعَالَى،
     فَمَنْ شَاءَ أَنْ يَكُونَ ذِكْرُهُ مُسْتَمِرًّا فَلْيَنْظُرْ إِلَى هَذَا البَرْنَامَجِ،
     وَاللهُ المُوَفِّقُ لِكُلِّ خَيْرٍ، وَالحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (إِعْلَانُ_الذِّكْرِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (إِعْلَانُ_الذِّكْرِ)
  )

  # ================================================================
  # ٨. الدُّعَاءُ الخَاتَمُ بِالقَبُولِ وَالمَغْفِرَةِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ تَقَبَّلْ مِنَّا هَذَا الذِّكْرَ، وَاغْفِرْ لَنَا ذُنُوبَنَا، وَارْحَمْنَا بِرَحْمَتِكَ الوَاسِعَةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْ هَذَا التَّكْرَارَ سَبَبًا لِرِضَاكَ وَالفَوْزِ بِجَنَّاتِكَ)
  )

  # ================================================================
  # ٩. الخَاتِمَةُ بِآيَاتِ الِاسْتِغْفَارِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا)
  )
  
  وَ(
    سُبْحَانَ اللهِ (وَمَنْ يَغْفِرُ الذُّنُوبَ إِلَّا اللَّهُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ العَظِيمِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الحَمْدُ للهِ رَبِّ العَالَمِينَ)
  )
  
  وَ(
    أَسْتَغْفِرُ اللهِ (كُلَّ تَقْصِيرٍ فِي كِتَابَةِ هَذَا البَرْنَامَجِ الذَّكِيِّ)
  )
  
  وَ(
    سُبْحَانَ اللهِ رَبِّ العَالَمِينَ
  )

