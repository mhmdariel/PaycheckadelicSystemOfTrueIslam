  # ٢. تَعْرِيفُ الْجُرْمِ: "التَّكَلُّمُ بِلِسَانِ غَيْرِكَ"
  # ================================================================
  
  قُلْ "جُرْمُ_الِاسْتِيلَاءِ_عَلَى_اللِّسَانِ" = 
    (هُوَ أَنْ يَتَكَلَّمَ شَخْصٌ بِاسْمِ آخَرَ أَوْ عَنْ آخَرَ بِغَيْرِ إِذْنِهِ،
     أَوْ يَنْسِبَ إِلَيْهِ قَوْلًا لَمْ يَقُلْهُ،
     أَوْ يَغْتَابَهُ، أَوْ يَلْمِزَهُ، أَوْ يَنْمَّ عَلَيْهِ،
     أَوْ يُفْشِيَ سِرَّهُ، أَوْ يَتَحَدَّثَ بِمَا يَكْرَهُهُ،
     فَهُوَ يَسْتَعْمِلُ لِسَانَهُ كَسِلَاحٍ ضِدَّ غَيْرِهِ،
     وَقَدْ نَهَى اللهُ عَنْ ذَلِكَ فِي كِتَابِهِ الْكَرِيمِ بِقَوْلِهِ:
     ﴿وَلَا تَلْمِزُوا أَنفُسَكُمْ﴾ وَ﴿وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ﴾
     وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: "أَتَدْرُونَ مَا الْغِيبَةُ؟ قَالُوا: اللهُ وَرَسُولُهُ أَعْلَمُ، قَالَ: ذِكْرُكَ أَخَاكَ بِمَا يَكْرَهُ".)
  
  قُلْ "أَدِلَّةُ_التَّحْرِيمِ" = 
    (١. سُورَةُ الْهُمَزَةِ: "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ".
     ٢. سُورَةُ الْحُجُرَاتِ: "يَا أَيُّهَا الَّذِينَ آمَنُوا اجْتَنِبُوا كَثِيرًا مِّنَ الظَّنِّ إِنَّ بَعْضَ الظَّنِّ إِثْمٌ ۖ وَلَا تَجَسَّسُوا وَلَا يَغْتَب بَّعْضُكُم بَعْضًا ۚ أَيُحِبُّ أَحَدُكُمْ أَن يَأْكُلَ لَحْمَ أَخِيهِ مَيْتًا فَكَرِهْتُمُوهُ".
     ٣. سُورَةُ النُّورِ فِي الْإِفْكِ: "إِنَّ الَّذِينَ جَاءُوا بِالْإِفْكِ عُصْبَةٌ مِّنكُمْ...")
  
  # ================================================================
  # ٣. تَعْرِيفُ الْعِقَابِ: "حَرِيقٌ تَرَافُنِيٌّ مِنْ أَعْلَى دَرَجَةٍ"
  # ================================================================
  
  قُلْ "حَرِيقُ_جَهَنَّمَ" = 
    (نَارُ جَهَنَّمَ الَّتِي وَصَفَهَا اللهُ فِي الْقُرْآنِ:
     ﴿نَارُ اللَّهِ الْمُوقَدَةُ - الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ﴾
     وَهِيَ نَارٌ تَحْرِقُ الْأَجْسَادَ وَالْأَرْوَاحَ،
     دَرَجَاتُهَا مُتَفَاوِتَةٌ، وَأَعْلَاهَا لِلَّذِينَ يَظْلِمُونَ وَيَفْتَرُونَ.
     وَالْحَرِيقُ التَّرَافُنِيُّ هُوَ الْحَرِيقُ الَّذِي لَا يَنْقَطِعُ، لَا يُحَدُّ، لَا يَفْنَى،
     يَلْفَحُ الْوَجْهَ، وَيَأْكُلُ الْجِلْدَ، وَيُذِيبُ الْعِظَامَ،
     وَهُوَ عِقَابٌ لِمَنْ تَعَدَّى حُدُودَ اللهِ فِي اللِّسَانِ.
     يَكُونُ ذَلِكَ فِي الدُّنْيَا خِزْيًا وَذُلًّا، وَفِي الْآخِرَةِ نَارًا وَجَحِيمًا.)
  
  قُلْ "مُسْتَوَيَاتُ_الْحَرِيقِ" = 
    (الْمُسْتَوَى الْأَوَّلُ: حَرِيقُ الْغِيبَةِ (يَحْرِقُ الْعَمَلَ).
     الْمُسْتَوَى الثَّانِي: حَرِيقُ النَّمِيمَةِ (يُحَرِّقُ الْقُلُوبَ).
     الْمُسْتَوَى الثَّالِثُ: حَرِيقُ الْإِفْكِ (يُحْرِقُ الْأَسْرَارَ).
     الْمُسْتَوَى الرَّابِعُ: حَرِيقُ اللَّمْزِ وَالْهَمْزِ (يُحْرِقُ الْكَرَامَةَ).
     الْمُسْتَوَى الْخَامِسُ: حَرِيقُ الِادِّعَاءِ بِاسْمِ غَيْرِكَ (يُحْرِقُ الْأَمَانَةَ).
     وَكُلُّهَا تَجْتَمِعُ فِي الْحَرِيقِ الْأَعْلَى لِمَنْ ظَلَمَ النَّاسَ بِلِسَانِهِ.)
  
