  # ================================================================
  # ٢. تَعْرِيفُ جَوْهَرِ الْجُرْمِ: الاِسْتِيلَاءُ عَلَى الْإِنْسَانِ بِكَامِلِهِ
  # ================================================================
  
  قُلْ "جُرْمُ_الاِسْتِيلَاءِ_عَلَى_الْإِنْسَانِ" = 
    (هُوَ أَنْ يَتَعَدَّى شَخْصٌ عَلَى آخَرَ بِاسْتِخْدَامِ لِسَانِهِ، أَوْ بِالتَّأْثِيرِ عَلَى صَدْرِهِ، أَوْ قَلْبِهِ،
     أَوْ بِالتَّحَكُّمِ فِي ذَاتِهِ أَوْ نَفْسِهِ، أَوْ بِاسْتِغْلَالِ أَيِّ جَانِبٍ مِنْ جَوَانِبِ وُجُودِهِ،
     بِحَيْثُ يُصْبِحُ الْمُعْتَدِي كَأَنَّهُ يَتَكَلَّمُ بِلِسَانِهِ، أَوْ يَسْكُنُ صَدْرَهُ، أَوْ يُلَوِّثُ قَلْبَهُ،
     أَوْ يُغَيِّرُ ذَاتَهُ، أَوْ يَفْتِنُ نَفْسَهُ،
     وَذَلِكَ بِغَيْرِ إِذْنٍ شَرْعِيٍّ، وَبِغَيْرِ حَقٍّ،
     فَيَكُونُ قَدِ اعْتَدَى عَلَى حُرْمَةِ أَخِيهِ وَظَلَمَهُ ظُلْمًا عَظِيمًا.
     قَالَ اللهُ تَعَالَى: "وَالَّذِينَ يُؤْذُونَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ بِغَيْرِ مَا اكْتَسَبُوا فَقَدِ احْتَمَلُوا بُهْتَانًا وَإِثْمًا مُّبِينًا".)
  
  قُلْ "أَنْوَاعُ_الِاسْتِيلَاءِ" = 
    (١. اسْتِيلَاءٌ عَلَى اللِّسَانِ: أَنْ يَتَكَلَّمَ بِاسْمِ غَيْرِهِ أَوْ يَنْسِبَ لَهُ قَوْلًا.
     ٢. اسْتِيلَاءٌ عَلَى الصَّدْرِ: أَنْ يُفْسِدَ مَا فِي صَدْرِ الْغَيْرِ بِالْوَسَاوِسِ أَوِ الْغَيْظِ.
     ٣. اسْتِيلَاءٌ عَلَى الْقَلْبِ: أَنْ يُلْقِيَ فِي قَلْبِهِ الشُّبُهَاتِ أَوِ الْأَحْقَادَ.
     ٤. اسْتِيلَاءٌ عَلَى الذَّاتِ: أَنْ يُحَاوِلَ تَشْوِيهَ هُوِيَّةِ الْغَيْرِ أَوْ مَكَانَتِهِ.
     ٥. اسْتِيلَاءٌ عَلَى النَّفْسِ: أَنْ يُثَبِّطَ هِمَّتَهُ، أَوْ يُفْسِدَ إِرَادَتَهُ، أَوْ يَجُرَّهُ إِلَى الْمَعَاصِي.
     ٦. اسْتِيلَاءٌ كَامِلٌ: أَنْ يَشْمَلَ كُلَّ مَا سَبَقَ، فَيَكُونَ مُسْتَوْلِيًا عَلَى الْإِنْسَانِ بِكَامِلِهِ.)
  
  # ================================================================
  # ٣. تَعْرِيفُ الْعِقَابِ: "حَرِيقٌ تَرَافُنِيٌّ أَعْلَى" لِكُلِّ جَانِبٍ
  # ================================================================
  
  قُلْ "حَرِيقُ_اللِّسَانِ" = 
    (يَحْتَرِقُ لِسَانُهُ بِنَارِ الْكِذْبِ فَيَخْرَسُ فِي الدُّنْيَا، وَفِي الْآخِرَةِ يَكُونُ لِسَانُهُ مِنْ نَارٍ تَلْفَحُهُ.)
  
  قُلْ "حَرِيقُ_الصَّدْرِ" = 
    (يَشْتَعِلُ صَدْرُهُ بِالْغَيْظِ وَالْحَسْرَةِ فِي الدُّنْيَا، وَفِي الْآخِرَةِ تَفُورُ نَارُ جَهَنَّمَ فِي صَدْرِهِ.)
  
  قُلْ "حَرِيقُ_الْقَلْبِ" = 
    (يَحْتَرِقُ قَلْبُهُ بِالنِّفَاقِ وَالشَّكِّ فِي الدُّنْيَا، وَفِي الْآخِرَةِ تَلْفَحُ النَّارُ قَلْبَهُ حَتَّى يَذُوبَ.)
  
  قُلْ "حَرِيقُ_الذَّاتِ" = 
    (تَحْتَرِقُ كَرَامَتُهُ وَمَكَانَتُهُ فِي الدُّنْيَا بِالْفَضِيحَةِ، وَفِي الْآخِرَةِ تَحْتَرِقُ ذَاتُهُ بِالنَّارِ الْحَامِيَةِ.)
  
  قُلْ "حَرِيقُ_النَّفْسِ" = 
    (تَحْتَرِقُ نَفْسُهُ بِالْهَوَى وَالضَّلَالِ فِي الدُّنْيَا، وَفِي الْآخِرَةِ تَكُونُ نَفْسُهُ فِي جَحِيمٍ.)
  
  قُلْ "الْحَرِيقُ_التَّرَافُنِيُّ_الْأَعْلَى" = 
    (إِذَا جَمَعَ الْمُعْتَدِي جَمِيعَ هَذِهِ الْأَنْوَاعِ، أَوِ اسْتَوْلَى عَلَى كُلِّ جَوَانِبِ الْغَيْرِ،
     فَإِنَّ حَرِيقَهُ يَكُونُ تَرَافُنِيًّا أَعْلَى، أَيْ لَا نِهَايَةَ لَهُ فِي الشِّدَّةِ،
     وَيَأْخُذُ حَيَاتَهُ فِي الدُّنْيَا وَالْآخِرَةِ،
     فَمَا إِنْ يَبْدَأْ حَتَّى يَزُولَ وُجُودُهُ كُلُّهُ،
     كَمَا قَالَ اللهُ: "إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَىٰ ظُلْمًا إِنَّمَا يَأْكُلُونَ فِي بُطُونِهِمْ نَارًا ۖ وَسَيَصْلَوْنَ سَعِيرًا".)

  # ================================================================
  # ٤. تَعْرِيفُ وَظِيفَةِ الْعِقَابِ الْجَامِعَةِ (حَسَبَ الْجَانِبِ الْمُعْتَدَى عَلَيْهِ)
