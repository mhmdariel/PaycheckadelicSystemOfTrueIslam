  // 7. SECURITY READINESS REPORT

  function readinessReport(actor) {
    authorize(actor, "REPORT_READ");

    const assets = [...DATABASE.assets.values()];
    const controls = [...DATABASE.controls.values()];
    const threats = [...DATABASE.threats.values()];
    const incidents = [...DATABASE.incidents.values()];

    const controlCoverage = assets.map(asset => {
      const associated = controls.filter(
        control => control.assetId === asset.id
      );

      return {
        asset: asset.name,
        type: asset.type,
        registeredControls: associated.length,
        activeControls: associated.filter(
          control => control.status === "ACTIVE"
