  const DATABASE = {
    assets: new Map(),
    controls: new Map(),
    threats: new Map(),
    incidents: new Map(),
    personnel: new Map(),
    audits: [],
    recoveryPlans: new Map()
  };

  const ROLES = Object.freeze({
    OWNER: "OWNER",
    SECURITY_ADMIN: "SECURITY_ADMIN",
    RESPONDER: "RESPONDER",
