  const uuid = () =>
    globalThis.crypto?.randomUUID?.() ??
    "id-" + Math.random().toString(36).slice(2);

  function authorize(actor, permission) {
    if (!actor || !actor.authenticated) {
      throw new Error("Authenticated human authorization required.");
    }

    const allowed = PERMISSIONS[actor.role] || [];

    if (!allowed.includes("*") &&
        !allowed.includes(permission)) {
      throw new Error("Insufficient authorization.");
    }

    return true;
  }

  function audit(actor, action, details = {}) {
    DATABASE.audits.push(Object.freeze({
      id: uuid(),
      timestamp: new Date().toISOString(),
      actor: actor?.id || "SYSTEM",
      action,
      details: Object.freeze({ ...details })
    }));
  }

  // 1. PHYSICAL ESTATE PROTECTION

  function registerAsset(actor, data) {
    authorize(actor, "ASSET_WRITE");

    const permittedTypes = [
      "LAND",
      "BUILDING",
      "RESIDENCE",
      "UTILITY",
      "COMMUNICATIONS",
      "TRANSPORT",
      "DATA_CENTRE",
      "EMERGENCY_FACILITY",
      "DEFENSIVE_INFRASTRUCTURE"
    ];

    if (!permittedTypes.includes(data.type)) {
      throw new Error("Unsupported asset type.");
    }

    const asset = Object.freeze({
      id: uuid(),
      name: data.name,
      type: data.type,
      location: data.location || "UNSPECIFIED",
      criticality: data.criticality || "MEDIUM",
      ownerReference: data.ownerReference || null,
      status: "REGISTERED",
      created: new Date().toISOString()
    });

    DATABASE.assets.set(asset.id, asset);

    audit(actor, "ASSET_REGISTERED", {
      assetId: asset.id,
      type: asset.type
    });

    return asset;
  }

  // 2. DEFENSIVE SECURITY CONTROLS

  function installControl(actor, assetId, control) {
    authorize(actor, "CONTROL_WRITE");

    if (!DATABASE.assets.has(assetId)) {
      throw new Error("Unknown estate asset.");
    }

    const permittedControls = [
      "ACCESS_CONTROL",
      "CCTV_PRIVACY_COMPLIANT",
      "INTRUSION_DETECTION",
      "FIRE_DETECTION",
      "FIRE_SUPPRESSION",
      "ENVIRONMENTAL_MONITORING",
      "LIGHTING",
      "PHYSICAL_INSPECTION",
      "CYBERSECURITY",
      "BACKUP_POWER",
      "WATER_REDUNDANCY",
      "EMERGENCY_COMMS",
      "INSURANCE",
      "PROFESSIONAL_GUARDING",
      "EVACUATION_PLANNING"
    ];

    if (!permittedControls.includes(control.type)) {
      throw new Error("Unapproved security control.");
    }

    const entry = Object.freeze({
      id: uuid(),
      assetId,
      type: control.type,
      status: "PLANNED",
      responsibleParty: control.responsibleParty || null,
      reviewDate: control.reviewDate || null,
      created: new Date().toISOString()
    });

    DATABASE.controls.set(entry.id, entry);

    audit(actor, "CONTROL_REGISTERED", {
      assetId,
      control: entry.type
    });

    return entry;
  }

  // 3. THREAT AND RISK MANAGEMENT

  function assessThreat(actor, data) {
    authorize(actor, "THREAT_WRITE");

    const severityLevels = [
      "LOW",
      "MODERATE",
      "HIGH",
      "CRITICAL"
    ];

    if (!severityLevels.includes(data.severity)) {
      throw new Error("Invalid severity.");
    }

    const threat = Object.freeze({
      id: uuid(),
      category: data.category,
      description: data.description,
      affectedAsset: data.assetId || null,
      severity: data.severity,
      mitigation: data.mitigation || "REQUIRES_REVIEW",
      status: "OPEN",
      timestamp: new Date().toISOString()
    });

    DATABASE.threats.set(threat.id, threat);

    audit(actor, "THREAT_ASSESSED", {
      threatId: threat.id,
      severity: threat.severity
    });

    return threat;
  }

  // 4. INCIDENT MANAGEMENT

  function recordIncident(actor, data) {
    authorize(actor, "INCIDENT_WRITE");

    const incident = Object.freeze({
      id: uuid(),
      category: data.category,
      description: data.description,
      assetId: data.assetId || null,
      severity: data.severity || "MODERATE",
      status: "OPEN",
      humanReviewRequired: true,
      emergencyServicesRequired:
        data.emergencyServicesRequired === true,
      timestamp: new Date().toISOString()
    });

    DATABASE.incidents.set(incident.id, incident);

    audit(actor, "INCIDENT_RECORDED", {
      incidentId: incident.id,
      severity: incident.severity
    });

    return incident;
  }

