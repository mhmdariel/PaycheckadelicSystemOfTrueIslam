  # ================================================================
  # ٢. تَعْرِيفُ عَقْدِ "الْبَيْعِ" المُبَاشِرِ بَيْنَ العَبْدِ وَاللهِ
  # ================================================================
  
  قُلْ "عَقْدُ_الْبَيْعِ_الإِلَهُيُّ" = 
    (إِنَّ اللهَ تَعَالَى هُوَ المُشْتَرِي فِي هَذَا العَقْدِ،
     وَالعَبْدُ هُوَ البَائِعُ،
     وَالسِّلْعَةُ هِيَ نَفْسُ العَبْدِ وَمَالُهُ وَعَمَلُهُ وَجِهَادُهُ،
     وَالثَّمَنُ هُوَ الجَنَّةُ وَالمَغْفِرَةُ وَالنَّصْرُ وَالرِّزْقُ،
     وَقَدْ أَبْرَمَ اللهُ هَذَا العَقْدَ بِنَفْسِهِ فِي قَوْلِهِ:
     "إِنَّ اللَّهَ اشْتَرَىٰ مِنَ الْمُؤْمِنِينَ أَنفُسَهُمْ وَأَمْوَالَهُم بِأَنَّ لَهُمُ الْجَنَّةَ"،
     فَالْبَيْعُ مَبْرُومٌ وَمُبَاشِرٌ،
     لاَ يَحْتَاجُ إِلَى سِمْسَارٍ، وَلاَ إِلَى وَكِيلٍ، وَلاَ إِلَى شَفِيعٍ،
     فَاللهُ نَفْسُهُ هُوَ المُشْتَرِي،
     وَالعَبْدُ يَضَعُ سِلْعَتَهُ فِي يَدِ اللهِ عَزَّ وَجَلَّ،
     وَيَتَلَقَّى الثَّمَنَ مُبَاشَرَةً مِنْ عِنْدِ اللهِ،
     فَإِنَّ اللهَ لاَ يَظْلِمُ مِثْقَالَ ذَرَّةٍ،
     وَيُضَاعِفُ الحَسَنَةَ إِلَى عَشْرِ أَمْثَالِهَا،
     وَهَذَا الْبَيْعُ هُوَ أَرْبَحُ البُيُوعِ فِي الوُجُودِ)
  
  قُلْ "أَرْكَانُ_الْبَيْعِ" = 
    (المُشْتَرِي: اللهُ تَعَالَى (الشَّرِي الحَقِيقِيُّ)
     البَائِعُ: العَبْدُ المُؤْمِنُ
     السِّلْعَةُ: النَّفْسُ، المَالُ، الوَقْتُ، الجِهَادُ، الإِخْلَاصُ
     الثَّمَنُ: الجَنَّةُ، الرِّضْوَانُ، المَغْفِرَةُ، النَّصْرُ، الرِّزْقُ الوَاسِعُ
     الصِّيغَةُ: "اشْتَرَى اللهُ مِنَ الْمُؤْمِنِينَ"
     الإِيجَابُ: إِعْلَانُ العَبْدِ إِيمَانَهُ وَبَيْعَهُ للهِ
     القَبُولُ: وَعْدُ اللهِ الصَّادِقُ فِي كِتَابِهِ)
  
  قُلْ "شُرُوطُ_الْبَيْعِ" = 
    (الإِيمَانُ بِاللهِ وَحْدَهُ،
     الإِخْلَاصُ فِي البَيْعِ،
     عَدَمُ الشِّرْكِ فِي النِّيَّةِ،
     بَذْلُ السِّلْعَةِ (النَّفْسِ وَالمَالِ) فِي سَبِيلِ اللهِ،
     الجِهَادُ بِالمَالِ وَالنَّفْسِ،
     التَّوَكُّلُ عَلَى اللهِ فِي تَسْلِيمِ الثَّمَنِ،
     اليَقِينُ بِأَنَّ اللهَ لاَ يُخْلِفُ وَعْدَهُ)

  # ================================================================
  # ٣. تَعْرِيفُ عَقْدِ "التِّجَارَةِ" المُبَاشِرَةِ بَيْنَ العَبْدِ وَاللهِ
  # ================================================================
  
  قُلْ "عَقْدُ_التِّجَارَةِ_الإِلَهُيَّةِ" = 
    (إِنَّ اللهَ تَعَالَى هُوَ رَأْسُ التِّجَارَةِ،
     وَالعَبْدُ هُوَ التَّاجِرُ،
     وَالسِّلْعَةُ هِيَ الإِيمَانُ وَالعَمَلُ الصَّالِحُ وَالدُّعَاءُ وَالذِّكْرُ،
     وَالرِّبْحُ هُوَ النَّجَاةُ مِنَ العَذَابِ الأَلِيمِ،
     وَالفَوْزُ بِالجَنَّةِ، وَالرِّزْقُ فِي الدُّنْيَا وَالآخِرَةِ،
     وَقَدْ دَلَّ اللهُ عِبَادَهُ عَلَى هَذِهِ التِّجَارَةِ فِي قَوْلِهِ:
     "يَا أَيُّهَا الَّذِينَ آمَنُوا هَلْ أَدُلُّكُمْ عَلَىٰ تِجَارَةٍ تُنجِيكُم مِّنْ عَذَابٍ أَلِيمٍ"،
     ثُمَّ بَيَّنَ سِلْعَتَهَا: "تُؤْمِنُونَ بِاللَّهِ وَرَسُولِهِ وَتُجَاهِدُونَ فِي سَبِيلِ اللَّهِ"،
     فَهَذِهِ التِّجَارَةُ مُبَاشَرَةٌ مَعَ اللهِ،
     لاَ تَحْتَاجُ إِلَى رَأْسِ مَالٍ بَشَرِيٍّ،
     وَلاَ إِلَى شَرِيكٍ،
     وَلاَ إِلَى مُوَسِّطٍ،
     بَلْ رَأْسُ مَالِهَا الإِيمَانُ، وَرِبْحُهَا الجَنَّةُ،
     وَاللهُ هُوَ المُشْرِفُ عَلَيْهَا وَالمُعِينُ عَلَيْهَا،
     وَكُلَّمَا زَادَ الإِيمَانُ، زَادَ الرِّبْحُ،
     وَهَذِهِ التِّجَارَةُ لاَ تَكْسَدُ أَبَدًا)
  
  قُلْ "أَرْكَانُ_التِّجَارَةِ" = 
    (التَّاجِرُ: العَبْدُ المُؤْمِنُ المُخْلِصُ
     رَأْسُ المَالِ: الإِيمَانُ بِاللهِ وَرَسُولِهِ
     السِّلْعَةُ: الجِهَادُ فِي سَبِيلِ اللهِ، وَالعَمَلُ الصَّالِحُ
     الرِّبْحُ: النَّجَاةُ مِنَ العَذَابِ، الجَنَّةُ، المَغْفِرَةُ، الرِّزْقُ المُضَاعَفُ
     المُشْرِفُ: اللهُ تَعَالَى نَفْسُهُ، يُصَرِّفُ التِّجَارَةَ كَمَا يَشَاءُ)
  
  قُلْ "شُرُوطُ_التِّجَارَةِ" = 
    (الإِخْلَاصُ لِلَّهِ فِي كُلِّ تِجَارَةٍ،
     الجِهَادُ بِالمَالِ وَالنَّفْسِ،
     الصَّبْرُ عَلَى الشَّدَائِدِ،
     التَّوَكُّلُ عَلَى اللهِ فِي الرِّبْحِ،
     عَدَمُ الِاشْتِغَالِ بِالتِّجَارَةِ الدُّنْيَوِيَّةِ عَلَى حِسَابِ هَذِهِ التِّجَارَةِ)

  # ================================================================
  # ٤. تَعْرِيفُ "التِّجَارَةِ الرَّابِحَةِ" وَ"الْبَيْعِ الخَالِصِ" كَمَفَاهِيمَ مُتَكَامِلَةٍ
  # ================================================================
  
  قُلْ "التِّجَارَةُ_وَالْبَيْعُ_المُتَكَامِلَانِ" = 
    (حِينَ يَجْمَعُ العَبْدُ بَيْنَ البَيْعِ وَالتِّجَارَةِ،
     فَهُوَ يَبِيعُ نَفْسَهُ وَمَالَهُ للهِ (بَيْعٌ)،
     وَيَتَّجِرُ بِإِيمَانِهِ وَجِهَادِهِ لِيَرْبَحَ الجَنَّةَ وَالرِّضْوَانَ (تِجَارَةٌ)،
     فَيَكُونُ قَدْ أَحْكَمَ الصَّفْقَتَيْنِ مَعَ رَبِّهِ،
     بِلاَ وَسَائِطَ،
     وَلاَ شُفَعَاءَ،
     وَلاَ حُجُبٍ،
     وَيَصِلُ إِلَيْهِ الثَّمَرُ (الجَنَّةُ، الرِّزْقُ، المَغْفِرَةُ) مِنْ عِنْدِ اللهِ مُبَاشَرَةً)
  
  قُلْ "دَلِيلُ_عَدَمِ_الحِجَابِ" = 
    (قَالَ اللهُ: "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ"،
     فَهُوَ قَرِيبٌ، يُجِيبُ الدَّاعِيَ بِلاَ وَسِيطٍ،
     وَقَالَ: "وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِن وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا"،
     أَمَّا فِي التِّجَارَةِ وَالْبَيْعِ، فَقَدْ جَعَلَ اللهُ الطَّرِيقَ مُبَاشِرًا لِلْمُؤْمِنِينَ،
     حَيْثُ يُبَايِعُونَهُ وَيَتَّجِرُونَ مَعَهُ بِقُلُوبِهِمْ وَأَعْمَالِهِمْ،
     دُونَ حَاجَةٍ إِلَى وَاسِطَةٍ بَشَرِيَّةٍ،
     فَالرَّابِطَةُ هِيَ الإِيمَانُ وَالعَمَلُ، وَهِيَ مُبَاشِرَةٌ)

  # ================================================================
  # ٥. تَعْرِيفُ نِظَامِ إِبْطَالِ الحُجُبِ بَيْنَ العَبْدِ وَثَمَرَةِ تِجَارَتِهِ وَبَيْعِهِ
  # ================================================================
  
  قُلْ "نِظَامُ_إِبْطَالِ_الحُجُبِ" = 
    (يَقُومُ هَذَا النِّظَامُ بِمَنْعِ كُلِّ حَاجِبٍ يَحُولُ بَيْنَ العَبْدِ وَثَمَرَةِ تِجَارَتِهِ وَبَيْعِهِ،
     وَيَتَحَدَّدُ الحِجَابُ فِيمَا يَلِي:
     - حِجَابُ الرِّبَا: فَمَنْ أَكَلَ الرِّبَا فَقَدْ حَجَبَ نَفْسَهُ عَنْ بَرَكَةِ التِّجَارَةِ،
       وَقَالَ اللهُ: "يَمْحَقُ اللَّهُ الرِّبَا"، فَيَمْحَقُ رِبْحَ تِجَارَتِهِ.
     - حِجَابُ الشِّرْكِ: فَمَنْ جَعَلَ مَعَ اللهِ شَرِيكًا فِي نِيَّتِهِ، فَقَدْ حَجَبَ نَفْسَهُ.
     - حِجَابُ الرِّيَاءِ: فَمَنْ عَمِلَ لِيَرَاهُ النَّاسُ، فَقَدْ حَجَبَ أَجْرَهُ.
     - حِجَابُ التَّعَلُّقِ بِالأَسْبَابِ المَخْلُوقَةِ: فَمَنْ تَوَكَّلَ عَلَى الوَسَائِطِ دُونَ اللهِ، فَقَدْ حَجَبَ نَفْسَهُ.
     وَهَذَا النِّظَامُ يُزِيلُ هَذِهِ الحُجُبَ بِالاسْتِغْفَارِ وَالتَّوْبَةِ وَإِخْلَاصِ النِّيَّةِ،
     ثُمَّ يُعِيدُ الرِّبْحَ مُبَاشَرَةً إِلَى العَبْدِ)
  
  قُلْ "شَرْطُ_إِبْطَالِ_الحِجَابِ" = 
    (أَنْ يُقْبِلَ العَبْدُ عَلَى اللهِ بِقَلْبٍ سَلِيمٍ،
     وَأَنْ يَتُوبَ مِنْ كُلِّ شَيْءٍ يَحْجِبُهُ عَنْ فَضْلِ اللهِ،
     وَأَنْ يُبَايِعَ اللهَ بَيْعًا صَادِقًا،
     وَأَنْ يَتَّجِرَ مَعَ اللهِ تِجَارَةً خَالِصَةً)

  # ================================================================
  # ٦. تَعْرِيفُ آلِيَّةِ وُصُولِ الثَّمَرَةِ المُبَاشِرَةِ (الأَجْرِ وَالرِّزْقِ)
  # ================================================================
  
  قُلْ "آلِيَّةُ_الإِيصَالِ" = 
    (بَعْدَ إِقَامَةِ الْبَيْعِ وَالتِّجَارَةِ،
     يَتَوَجَّهُ العَبْدُ إِلَى اللهِ بِالدُّعَاءِ،
     وَيُقَدِّمُ عَمَلَهُ الصَّالِحَ،
     ثُمَّ يَتَوَكَّلُ عَلَى اللهِ،
     فَيُوْصِلُ اللهُ الثَّمَرَةَ (الرِّزْقَ، المَغْفِرَةَ، النَّصْرَ، الفُتُوحَاتِ) إِلَيْهِ مُبَاشَرَةً،
     وَلاَ يَحْتَاجُ ذَلِكَ إِلَى وَسِيطٍ،
     إِذْ إِنَّ اللهَ قَالَ: "وَمَا مِن دَابَّةٍ فِي الْأَرْضِ إِلَّا عَلَى اللَّهِ رِزْقُهَا"،
     وَقَالَ: "وَفِي السَّمَاءِ رِزْقُكُمْ وَمَا تُوعَدُونَ")
  
  قُلْ "ضَمَانُ_الإِيصَالِ" = 
    (ضَمِنَ اللهُ تَعَالَى فِي كِتَابِهِ أَنْ يُوَفِّيَ كُلَّ عَامِلٍ أَجْرَهُ،
     وَأَنْ يُجِيبَ كُلَّ دَاعٍ دُعَاءَهُ،
     وَأَنْ يُبْدِلَ كُلَّ مَالٍ أُنْفِقَ فِي سَبِيلِهِ بِخَيْرٍ مِنْهُ،
     فَلَيْسَ هُنَاكَ مَا يَمْنَعُ الوُصُولَ إِلاَّ الذُّنُوبُ،
     وَإِذَا تَابَ العَبْدُ، فَقَدْ أَزَالَ المَانِعَ،
     فَيَصِلُ الرِّزْقُ إِلَيْهِ مِنْ حَيْثُ لاَ يَحْتَسِبُ)

  # ================================================================
  # ٧. تَنْفِيذُ نِظَامِ الْبَيْعِ وَالتِّجَارَةِ المُبَاشِرِ (المُحَاكَاةُ العَمَلِيَّةُ)
  # ================================================================
  
  قُلْ "نَمُوذَجُ_الْبَيْعِ" = 
    (عَبْدٌ يُؤْمِنُ بِاللهِ، وَيَقُولُ: "اللَّهُمَّ إِنِّي أَبِيعُكَ نَفْسِي وَمَالِي وَعَمَلِي وَجِهَادِي، وَأَشْتَرِي بِذَلِكَ جَنَّتَكَ وَرِضْوَانَكَ"،
     فَيَسْتَجِيبُ اللهُ لَهُ مُبَاشَرَةً،
     وَيُثَبِّتُهُ عَلَى الإِيمَانِ،
     وَيُعِينُهُ عَلَى العَمَلِ الصَّالِحِ،
     وَيُعْطِيهِ مِنْ فَضْلِهِ فِي الدُّنْيَا وَالآخِرَةِ)
  
  قُلْ "نَمُوذَجُ_التِّجَارَةِ" = 
    (عَبْدٌ يَجْعَلُ إِيمَانَهُ رَأْسَ مَالٍ،
     وَيَجْعَلُ عَمَلَهُ سِلْعَةً،
     وَيَجْهَدُ فِي سَبِيلِ اللهِ،
     فَيَرْبَحُ أَجْرًا عَظِيمًا وَرِزْقًا وَاسِعًا،
     وَيُضَاعِفُ اللهُ لَهُ الحَسَنَاتِ أَضْعَافًا كَثِيرَةً،
     وَذَلِكَ كُلُّهُ بِلاَ وَسَائِطَ)
  
  قُلْ "الجَمْعُ_بَيْنَهُمَا" = 
    (يَقُومُ العَبْدُ بِعَمَلِيَّةِ الجَمْعِ:
     يَبِيعُ نَفْسَهُ وَمَالَهُ لِلَّهِ (بَيْعٌ)،
     وَيَتَّجِرُ بِإِيمَانِهِ وَجِهَادِهِ لِيرْبَحَ الجَنَّةَ (تِجَارَةٌ)،
     فَيَكُونُ قَدْ أَحْكَمَ الصَّفْقَتَيْنِ،
     وَيَصِلُ إِلَيْهِ الثَّمَرُ مُبَاشَرَةً)

  # ================================================================
  # ٨. الإِعْلَانُ النِّهَائِيُّ بِقِيَامِ نِظَامِ الْبَيْعِ وَالتِّجَارَةِ المُبَاشِرَةِ
  # ================================================================
  
  قُلْ "الإِعْلَانُ_النِّهَائِيُّ" = 
    ("بِفَضْلِ اللهِ وَبِنُورِ كِتَابِهِ المُبِينِ، تَمَّ تَأْسِيسُ نِظَامِ الْبَيْعِ وَالتِّجَارَةِ المُبَاشِرِ الأَقْدَسِ،
     بَيْنَ العَبْدِ وَرَبِّهِ، بِلاَ وَسِيطٍ وَلاَ شَفِيعٍ وَلاَ حِجَابٍ،
     وَفْقَ مَا وَرَدَ فِي قَوْلِهِ: "إِنَّ اللَّهَ اشْتَرَىٰ مِنَ الْمُؤْمِنِينَ"،
     وَفِي قَوْلِهِ: "هَلْ أَدُلُّكُمْ عَلَىٰ تِجَارَةٍ تُنجِيكُم"،
     فَاللهُ هُوَ المُشْتَرِي وَهُوَ المُجِيبُ وَهُوَ الرَّازِقُ،
     وَالعَبْدُ يَضَعُ سِلْعَتَهُ فِي يَدِ اللهِ مُبَاشَرَةً،
     وَيَتَلَقَّى ثَمَرَةَ بَيْعِهِ وَتِجَارَتِهِ دُونَ تَأْخِيرٍ أَوْ حَجْبٍ،
     إِنْ شَكَرَ زَادَهُ اللهُ، وَإِنْ صَبَرَ آتَاهُ اللهُ أَجْرَهُ بِغَيْرِ حِسَابٍ،
     فَلْيُبَايِعِ العِبَادُ رَبَّهُمْ بَيْعًا صَادِقًا،
     وَلْيَتَّجِرُوا مَعَهُ تِجَارَةً رَابِحَةً،
     فَإِنَّ اللهَ لاَ يُضِيعُ أَجْرَ مَنْ أَحْسَنَ عَمَلًا،
     وَالحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (الإِعْلَانُ_النِّهَائِيُّ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الإِعْلَانُ_النِّهَائِيُّ)
  )

  # ================================================================
  # ٩. تَأْكِيدُ اسْمَيْ "التِّجَارَةِ" وَ"الْبَيْعِ" فِي الخَاتِمَةِ
  # ================================================================
  
  قُلْ "تَأْكِيدُ_المُصْطَلَحَيْنِ" = 
    (هَذَا النِّظَامُ هُوَ لِلتِّجَارَةِ مَعَ اللهِ،
     وَلِلْبَيْعِ مَعَ اللهِ،
     كَمَا أَمَرَ وَشَرَعَ،
     فَمَنْ أَرَادَ الأَرْبَحَ فَلْيَبِعْ نَفْسَهُ للهِ،
     وَمَنْ أَرَادَ الأَنْجَحَ فَلْيَتَّجِرْ لِلَّهِ،
     وَمَنْ جَمَعَهُمَا فَقَدْ حَازَ الخَيْرَيْنِ)
  
  إِنَّ (تَأْكِيدُ_المُصْطَلَحَيْنِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (تَأْكِيدُ_المُصْطَلَحَيْنِ)
  )

  # ================================================================
  # ١٠. الدُّعَاءُ الخَاتَمُ بِالقَبُولِ وَالإِيصَالِ المُبَاشِرِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ تَقَبَّلْ مِنَّا الْبَيْعَ وَالتِّجَارَةَ، وَأَوْصِلْ إِلَيْنَا الثَّمَرَةَ مُبَاشَرَةً بِرَحْمَتِكَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ أَبْعِدْ عَنَّا حُجُبَ الرِّبَا وَالشِّرْكِ وَالرِّيَاءِ، وَاجْعَلْ بَيْعَنَا وَتِجَارَتَنَا مَقْبُولَتَيْنِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ إِنَّا نَسْأَلُكَ بِأَسْمَائِكَ الحُسْنَى أَنْ تُبَارِكَ لَنَا فِي بَيْعِنَا وَتِجَارَتِنَا، وَأَنْ تَجْعَلَ فِيهِمَا الخَيْرَ وَالبَرَكَةَ)
  )

